# Copy this file to ".env" (same folder) and change values if needed.
# NEVER upload the real .env file to GitHub.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://libraria:libraria123@localhost:5432/libraria

# Login tokens: replace with your own long random text (see README step 5)
SECRET_KEY=change-me-to-a-long-random-string

# Ollama (local AI)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b
